+	fw_zap_seg = (const uint8_t *)p; fw_zap_seg_size = n;
+	if (SecureDTGetProperty(node, "gpu-sqe", &p, &n) != kSuccess) { return false; }
+	fw_sqe = (const uint8_t *)p; fw_sqe_size = n;
+	IOLog("TopazGPU: firmware from the device tree: zap %zu + %zu, sqe %zu bytes\n", fw_zap_mdt_size, fw_zap_seg_size, fw_sqe_size);
