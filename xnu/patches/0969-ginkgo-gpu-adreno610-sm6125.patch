+static bool
+gpu_fw_from_dt(void)
+{
+	DTEntry node;
+	const void *p;
+	unsigned int n;
+	if (SecureDTLookupEntry(NULL, "/chosen", &node) != kSuccess) {
+		return false;
+	}
+	if (SecureDTGetProperty(node, "gpu-zap-mdt", &p, &n) != kSuccess) { return false; }
