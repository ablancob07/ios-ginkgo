 static bool
+w_set_regdomain(uint32_t rd)
+{
+	uint8_t m[4 + 20] = {}, *p = wmi_put_tlv(m, TAG_PDEV_SET_REGDOMAIN, 20);
+	p = w_p32(p, rd);                           /* regd */
+	p = w_p32(p, rd);                           /* regd_2ghz */
+	p = w_p32(p, rd);                           /* regd_5ghz */
+	p = w_p32(p, 0);                            /* conformance_test_limit_2ghz */
+	w_p32(p, 0);                                /* conformance_test_limit_5ghz */
+	return wmi_send(CMD_PDEV_SET_REGDOMAIN, m, sizeof(m));
+}
