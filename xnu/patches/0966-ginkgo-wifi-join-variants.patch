+	unsigned v = g_variants[g_join_variant % (sizeof(g_variants) / sizeof(g_variants[0]))];
+	uint32_t fixed = (v & 4) ? 88 : 72;
+	uint8_t m[4 + 88 + 4 + 24 + 4] = {}, *p;
+	p = wmi_put_tlv(m, TAG_VDEV_START, fixed);
 	p = w_p32(p, 0);
 	p = w_p32(p, 0);
 	p = w_p32(p, bcn);
 	p = w_p32(p, dtim);
 	p = w_p32(p, 0);
 	p += 36 + 16;                               /* ssid (empty for a station), tx rate/power, noa, hw ack */
+	if (v & 4) {
+		p = w_p32(p, 1);                    /* preferred_rx_streams */
+		p = w_p32(p, 1);                    /* preferred_tx_streams */
+		p = w_p32(p, 0);                    /* cac_duration_ms */
+		p = w_p32(p, 0);                    /* regdomain */
+	}
 	p = w_channel(p, freq);
-	wmi_put_tlv(p, TAG_ARRAY_STRUCT, 0);
-	return wmi_send(CMD_VDEV_START, m, sizeof(m));
+	p = wmi_put_tlv(p, TAG_ARRAY_STRUCT, 0);
+	return wmi_send(CMD_VDEV_START, m, (uint32_t)(p - m));
 }
 
