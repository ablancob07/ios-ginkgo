 static uint8_t *w_pmac(uint8_t *p, const uint8_t *mac) { bzero(p, 8); memcpy(p, mac, 6); return p + 8; }
 
+/*
+ * ginkgo: the WCN3990 firmware answers VDEV_START with status -1 (and a 40-byte response, a newer
+ * WMI than topaz's). Each join tries the next variant and logs it, to find what this firmware wants:
+ * bit 0: HT phymode (11NG_HT20 = 5 / 11NA_HT20 = 4) + WMI_CHAN_FLAG_ALLOW_HT (bit 11)
+ * bit 1: VDEV_DOWN + VDEV_STOP before the start
+ * bit 2: extended start command (preferred rx/tx streams 1)
+ */
+static unsigned g_join_variant;
+static const unsigned g_variants[] = { 0, 1, 2, 4, 7, 5 };
+
 static uint8_t *
 w_channel(uint8_t *p, uint32_t freq)
 {
+	unsigned v = g_variants[g_join_variant % (sizeof(g_variants) / sizeof(g_variants[0]))];
+	uint32_t mode = (v & 1) ? (freq < 4000 ? 5u : 4u) : (freq < 4000 ? 1u : 0u);
+	uint32_t flags = (v & 1) ? (1u << 11) : 0;
 	uint8_t *c = wmi_put_tlv(p, TAG_CHANNEL, 24);
 	c = w_p32(c, freq);
 	c = w_p32(c, freq);
 	c = w_p32(c, 0);
-	c = w_p32(c, freq < 4000 ? 1 : 0);
+	c = w_p32(c, mode | flags);
 	c = w_p32(c, (40u << 8) | (40u << 16));
 	return w_p32(c, 40u << 8);
 }
